# Copy this file to .env.local and fill it in. .env.local is git-ignored, so it never gets committed.
# These are the public "web app" settings from the Firebase console (Project settings > Your apps).
# They are not secrets: access is protected by firestore.rules, not by hiding these values.

# --- Option A: practice mode (no Firebase account needed) ---
# Run `npm run emulators` in one terminal and `npm run dev` in another. Nothing real is touched.
# Only works in `npm run dev`; it is ignored by `npm run build`.
VITE_USE_EMULATORS=true

# --- Option B: your real Firebase project ---
# Set VITE_USE_EMULATORS=false above and paste the values from the Firebase console.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
